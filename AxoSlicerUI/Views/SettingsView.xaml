<UserControl x:Class="AxoSlicer_Ui.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AxoSlicer_Ui"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="LightGray">
    <StackPanel>
        <TextBlock Text="Settings" Margin="10" HorizontalAlignment="Center" />
        <Button Content="Load STL" Width="120" Margin="0 0 0 5" Command="{Binding LoadSTL}" />
        <TextBlock Text="{Binding filepath}" TextWrapping="Wrap" Margin="0 0 0 5"/>
    </StackPanel>
</UserControl>
